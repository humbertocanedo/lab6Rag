# --------------------------------------------------------------------
# InsightMate AI · variables de entorno
#
# Copia este archivo a .env y completa los valores.
#   cp .env.example .env   (o cópialo manualmente en Windows)
#
# IMPORTANTE: nunca subas tu archivo .env real al repositorio.
# --------------------------------------------------------------------

# API key de OpenRouter. Generala en https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_api_key_here

# (Opcional) Modelo a usar. Cualquier modelo soportado por OpenRouter.
# Ejemplos populares y económicos:
#   openai/gpt-4o-mini
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemini-flash-1.5
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
